# Public browser-safe Supabase details. Do not put service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential. Never prefix with NEXT_PUBLIC_.
# Preferred: SUPABASE_SECRET_KEY (newer Supabase naming).
# Backward-compatible fallback: SUPABASE_SERVICE_ROLE_KEY.
# Used by server-side storage and admin operations only.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Render Worker ────────────────────────────────────────────────────────────
# Leave empty to use the built-in local in-process worker (development only).
# Set to your external render worker's base URL for production (required on Vercel).
#
# IMPORTANT: FFmpeg is ~79 MB. It CANNOT run inside Vercel serverless functions
# (50 MB bundle limit). On Vercel, you MUST set WORKER_BASE_URL to an external
# worker (e.g. Fly.io free tier, Railway, or a self-hosted VPS).
#
# Local dev: leave empty (uses built-in LocalWorkerClient)
# Production: https://your-render-worker.fly.dev
WORKER_BASE_URL=

# Shared secret used to authenticate VideoForge → worker requests.
WORKER_SHARED_SECRET=

# ─── Large File Uploads ───────────────────────────────────────────────────────
# Asset and audio uploads use Supabase signed upload URLs.
# The browser PUTs files directly to Supabase Storage — the binary never passes
# through a Next.js function. This bypasses Vercel's 4.5 MB body limit.
# No extra configuration needed — this is the default upload behaviour.

# ---------------------------------------------------------------------------
# Script Studio AI provider — SERVER ONLY.
# Never prefix any of these with NEXT_PUBLIC_. The browser never receives them.
# ---------------------------------------------------------------------------

# "live" (default) calls a real OpenAI-compatible chat completions endpoint.
# Set to "manual" to disable AI and let users write scripts manually (free).
SCRIPT_PROVIDER_MODE=live

# Secret. Never commit, log, or echo this value.
# Leave empty for anonymous access to Kilo free models (kilo-auto/free, stepfun/step-3.7-flash:free).
SCRIPT_PROVIDER_API_KEY=

# Any OpenAI-compatible base URL. "/chat/completions" is appended for you.
# Examples: https://api.openai.com/v1  |  https://api.groq.com/openai/v1
#           https://api.kilo.ai/api/gateway  |  http://127.0.0.1:11434/v1 (local)
SCRIPT_PROVIDER_BASE_URL=https://api.kilo.ai/api/gateway

# Any chat model the endpoint serves that supports JSON output.
# For Kilo free gateway: kilo-auto/free or stepfun/step-3.7-flash:free
SCRIPT_PROVIDER_MODEL=kilo-auto/free

# Optional. Request timeout in milliseconds (5000-300000). Default 60000.
SCRIPT_PROVIDER_TIMEOUT_MS=60000

# ─── Text-to-Speech (TTS) / AI Narration ───────────────────────────────────────
# Default: Built-in zero-key Google TTS engine (100% free, no configuration needed).
# TTS_PROVIDER=google
#
# To use a higher-quality OpenAI-compatible speech synthesis model:
# TTS_PROVIDER=openai
# TTS_API_KEY=
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
# TTS_SPEED=1.0
# TTS_OUTPUT_FORMAT=mp3
#
# To use ElevenLabs high-fidelity narration:
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# TTS_MODEL=eleven_multilingual_v2
# TTS_VOICE=21m00Tcm4TlvDq8ikWAM
# TTS_OUTPUT_FORMAT=mp3

# ─── AI Visual / Image Generation ─────────────────────────────────────────────
# Default: Built-in high-quality Pollinations / Flux engine (100% free, zero-key).
#
# To use Hugging Face Inference Providers:
# IMAGE_PROVIDER=huggingface
# IMAGE_PROVIDER_API_KEY=hf_...
# IMAGE_PROVIDER_MODEL=black-forest-labs/FLUX.1-schnell
#
# To use Google Gemini API for image generation:
# IMAGE_PROVIDER=gemini
# IMAGE_PROVIDER_API_KEY=
# IMAGE_PROVIDER_MODEL=gemini-3.1-flash-image
#
# To use OpenAI / DALL-E or custom image generation endpoint:
# IMAGE_PROVIDER=openai
# IMAGE_PROVIDER_API_KEY=
# IMAGE_PROVIDER_BASE_URL=https://api.openai.com/v1
# IMAGE_PROVIDER_MODEL=dall-e-3

# ─── YouTube (Optional) ───────────────────────────────────────────────────────
# Only required if you want one-click YouTube publishing.
# Without these, Publish Studio uses manual package download mode.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

